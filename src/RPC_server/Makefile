
# This is a template Makefile generated by rpcgen

# Parameters

CLIENT = proxy-rpc
SERVER = server-rpc

SOURCES_CLNT.c = 
SOURCES_CLNT.h = 
SOURCES_SVC.c = 
SOURCES_SVC.h = 
SOURCES.x = RPC_ampliacion.x

TARGETS_SVC.c = RPC_ampliacion_svc.c server-rpc.c  RPC_ampliacion_xdr.c 
TARGETS_CLNT.c = proxy-rpc.c RPC_ampliacion_xdr.c RPC_ampliacion_clnt.c 
TARGETS = RPC_ampliacion.h RPC_ampliacion_xdr.c RPC_ampliacion_clnt.c RPC_ampliacion_svc.c

OBJECTS_CLNT = $(SOURCES_CLNT.c:%.c=%.o) $(TARGETS_CLNT.c:%.c=%.o)
OBJECTS_SVC = $(SOURCES_SVC.c:%.c=%.o) $(TARGETS_SVC.c:%.c=%.o)
# Compiler flags 

CPPFLAGS += -D_REENTRANT
CFLAGS += -g -I/usr/include/tirpc -I../../include
LDLIBS += -lnsl -lpthread -ltirpc
RPCGENFLAGS = 

# Targets 

all : $(SERVER) libRPC_ampliacion.so

$(TARGETS) : $(SOURCES.x) 
	rpcgen $(RPCGENFLAGS) $(SOURCES.x)

$(OBJECTS_CLNT) : $(SOURCES_CLNT.c) $(SOURCES_CLNT.h) $(TARGETS_CLNT.c) 

$(OBJECTS_SVC) : $(SOURCES_SVC.c) $(SOURCES_SVC.h) $(TARGETS_SVC.c) 

$(SERVER) : $(OBJECTS_SVC) 
	$(LINK.c) -o $(SERVER) $(OBJECTS_SVC) $(LDLIBS)

libRPC_ampliacion.so: proxy-rpc.o RPC_ampliacion_clnt.o RPC_ampliacion_xdr.o
	$(CC) -shared -o $@ $^ $(LDLIBS)

 clean:
	 $(RM) core  $(OBJECTS_CLNT) $(OBJECTS_SVC) $(CLIENT) $(SERVER) libRPC_ampliacion.so

